-- LÓGICA DO MOTION BLUR (Baseado na rotação da câmera)
local lastCameraCFrame = workspace.CurrentCamera.CFrame
RunService.RenderStepped:Connect(function()
    local currentCFrame = workspace.CurrentCamera.CFrame
    local delta = (currentCFrame.LookVector - lastCameraCFrame.LookVector).Magnitude
    local targetSize = math.clamp(delta * 500, 0, 100) -- Ajuste o multiplicador conforme necessário
    motionBlur.Size = targetSize
    lastCameraCFrame = currentCFrame
end)

